# ==============================================================================
# KEKAI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and populate variables if deploying to production.
#
# IMPORTANT:
# ALL THIRD-PARTY API KEYS ARE OPTIONAL.
# KEKAI operates at 100% functionality locally using deterministic reasoning.
# ==============================================================================

# Application Environment & Server Config
APP_ENV=development
DEBUG=false
PORT=8000
DATABASE_PATH=./brand_protection.db
TMP_DIR=./tmp
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# OpenRouter AI Reasoning Provider (Backend-Only — Never expose to Vite/Frontend)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=15
OPENROUTER_ENABLED=true

# Google Gemini AI API Key (Optional — Legacy fallback support)
GEMINI_API_KEY=

# Threat Intelligence Services
OPENPHISH_ENABLED=true
PHISHTANK_ENABLED=true
PHISHTANK_API_KEY=
PHISHTANK_TIMEOUT=10

# Visual Intelligence Engine
PHISHPEDIA_ENABLED=true
PHISHPEDIA_MODEL_DIR=./Phishpedia/models
PHISHPEDIA_LOGO_THRESHOLD=0.50

# Provider Takedown & Abuse Control Plane
ABUSE_SUBMISSION_MODE=DRY_RUN
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
